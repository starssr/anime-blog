<footer class="footer mt-5 h-auto text-base text-third-text-color relative border-t-2 border-t-border-color">
    <div class="info-container text-center" style="padding: 16px 0;">
        <div style="line-height:1.2;">
            <span>&copy; <%= date(new Date(), 'YYYY' ) %> <%= config.author || config.title %></span>
            <% if (theme.footer && theme.footer.customized_text) { %>
                <span class="footer-separator">|</span>
                <span class="footer-customized-text"><%- theme.footer.customized_text %></span>
            <% } %>
        </div>
        <div style="line-height:1.2; margin-top: 8px;">
            <% if (theme.footer && theme.footer.icp && theme.footer.icp.enable) { %>
                <a href="<%= theme.footer.icp.url %>" target="_blank"><%= theme.footer.icp.number %></a>
            <% } %>
        </div>
    </div>
</footer>
